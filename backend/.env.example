# Configuração do Postgres usada pelo docker-compose.yml
POSTGRES_USER=garden
POSTGRES_PASSWORD=garden
POSTGRES_DB=garden_manager
POSTGRES_PORT=5432

# Configuração da API (cmd/api). Ao rodar a API fora do Docker, aponte
# DATABASE_URL para localhost usando a mesma porta de POSTGRES_PORT acima.
HTTP_PORT=8080
DATABASE_URL=postgres://garden:garden@localhost:5432/garden_manager?sslmode=disable

# Gere um segredo forte antes de usar em produção, por exemplo com:
#   openssl rand -base64 48
JWT_SECRET=troque-este-valor-por-um-segredo-forte-antes-de-usar-em-producao
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
