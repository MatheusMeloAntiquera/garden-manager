    {
      "_id": "req_species_list",
      "_type": "request",
      "parentId": "fld_species",
      "name": "List Species",
      "description": "Busca espécies no catálogo. Parâmetros opcionais: q (nome popular ou científico, sem diferenciar acentos), category (folhagem, suculenta, flor, arvore, erva, hortalica, frutifera, grama), page e page_size (1 a 100).\n\nO after-response script grava o id da primeira espécie retornada na variável species_id.",
      "method": "GET",
      "url": "{{ _.base_url }}/api/v1/species",
      "body": {},
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ _.access_token }}" }
      ],
      "parameters": [
        { "name": "q", "value": "seringueira" },
        { "name": "category", "value": "folhagem", "disabled": true },
        { "name": "page", "value": "1" },
        { "name": "page_size", "value": "20" }
      ],
      "authentication": {},
      "afterResponseScript": "if (insomnia.response.code === 200) {\n  const body = insomnia.response.json();\n  if (body.data.length > 0) {\n    insomnia.environment.set('species_id', body.data[0].id);\n    console.log('species_id salvo no environment: ' + body.data[0].scientific_name);\n  }\n} else {\n  console.log('Busca falhou. Status:', insomnia.response.code);\n}",
      "metaSortKey": 1,
      "isPrivate": false,
      "settingStoreCookies": true,
