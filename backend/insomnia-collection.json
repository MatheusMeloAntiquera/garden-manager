      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
    {
      "_id": "req_refresh",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Refresh",
      "description": "Troca um refresh_token válido por um novo par de tokens (rotação: o refresh_token antigo é revogado).\n\nO after-response script atualiza access_token e refresh_token com os novos valores.",
      "method": "POST",
      "url": "{{ _.base_url }}/api/v1/auth/refresh",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"refresh_token\": \"{{ _.refresh_token }}\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {},
      "afterResponseScript": "if (insomnia.response.code === 200) {\n  const body = insomnia.response.json();\n  insomnia.environment.set('access_token', body.access_token);\n  insomnia.environment.set('refresh_token', body.refresh_token);\n  console.log('Tokens atualizados no environment.');\n} else {\n  console.log('Refresh falhou, tokens não foram atualizados. Status:', insomnia.response.code);\n}",
      "metaSortKey": 4,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
    {
      "_id": "req_logout",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Logout",
      "description": "Revoga o refresh_token informado. O access_token em uso continua válido até expirar.\n\nO after-response script limpa os tokens do environment quando o logout dá certo (204).",
      "method": "POST",
      "url": "{{ _.base_url }}/api/v1/auth/logout",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"refresh_token\": \"{{ _.refresh_token }}\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {},
      "afterResponseScript": "if (insomnia.response.code === 204) {\n  insomnia.environment.set('access_token', '');\n  insomnia.environment.set('refresh_token', '');\n  console.log('Logout confirmado, tokens limpos do environment.');\n} else {\n  console.log('Logout falhou. Status:', insomnia.response.code);\n}",
      "metaSortKey": 5,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
    {
      "_id": "fld_environments",
      "_type": "request_group",
      "parentId": "wrk_garden_manager_auth",
      "name": "Environments",
      "description": "CRUD de ambientes do usuário autenticado. Rode o Login antes para preencher o access_token.",
      "metaSortKey": 2
    },
    {
      "_id": "req_environments_create",
      "_type": "request",
      "parentId": "fld_environments",
      "name": "Create Environment",
      "description": "Cria um ambiente. active é opcional (padrão true).\n\nO after-response script grava o id criado na variável environment_id.",
      "method": "POST",
      "url": "{{ _.base_url }}/api/v1/environments",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Cozinha\",\n  \"notes\": \"Janela voltada para o leste\",\n  \"active\": true\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {{ _.access_token }}" }
      ],
      "parameters": [],
      "authentication": {},
      "afterResponseScript": "if (insomnia.response.code === 201) {\n  const body = insomnia.response.json();\n  insomnia.environment.set('environment_id', body.id);\n  console.log('environment_id salvo no environment.');\n} else {\n  console.log('Criação falhou. Status:', insomnia.response.code);\n}",
      "metaSortKey": 1,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
