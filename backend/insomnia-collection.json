    {
      "_id": "req_signup",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Signup",
      "description": "Cria uma nova conta.",
      "method": "POST",
      "url": "{{ _.base_url }}/api/v1/auth/signup",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Maria Teste\",\n  \"email\": \"maria@example.com\",\n  \"password\": \"Sup3r$ecret1\",\n  \"birth_date\": \"1990-05-20\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
