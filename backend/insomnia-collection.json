      "settingFollowRedirects": "global"
    },
    {
      "_id": "req_login",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Login",
      "description": "Autentica e retorna o par access_token/refresh_token.\n\nO after-response script grava os dois tokens direto nas variáveis de ambiente access_token e refresh_token.",
      "method": "POST",
      "url": "{{ _.base_url }}/api/v1/auth/login",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"maria@example.com\",\n  \"password\": \"Sup3r$ecret1\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {},
      "afterResponseScript": "if (insomnia.response.code === 200) {\n  const body = insomnia.response.json();\n  insomnia.environment.set('access_token', body.access_token);\n  insomnia.environment.set('refresh_token', body.refresh_token);\n  console.log('Tokens atualizados no environment.');\n} else {\n  console.log('Login falhou, tokens não foram atualizados. Status:', insomnia.response.code);\n}",
      "metaSortKey": 2,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
    {
      "_id": "req_users_me",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Get Me",
      "description": "Retorna os dados do usuário autenticado. Requer o header Authorization com o access_token do login.",
      "method": "GET",
      "url": "{{ _.base_url }}/api/v1/users/me",
      "body": {},
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ _.access_token }}" }
      ],
      "parameters": [],
      "authentication": {},
      "metaSortKey": 3,
